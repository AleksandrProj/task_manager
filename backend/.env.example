# Local PostgreSQL address; Docker overrides this with postgres:5432.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=root

# Development settings. APP_PORT is the local/Docker published web port.
APP_PORT=8000
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Replace with your own secret; keep .env out of Git.
DJANGO_SECRET=change-me-for-local-development
